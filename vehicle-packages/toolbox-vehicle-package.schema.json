{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolbox.local/schemas/vehicle-package-v1.json",
  "title": "Toolbox Vehicle Package manifest",
  "type": "object",
  "required": ["schemaVersion", "packageVersion", "vehicle", "license", "layers", "components", "meshMappings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageVersion": { "type": "string", "minLength": 1 },
    "vehicle": { "type": "object", "required": ["id", "make", "model", "displayName", "accuracy"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "make": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "displayName": { "type": "string", "minLength": 1 }, "year": { "type": ["integer", "null"] }, "accuracy": { "enum": ["exact", "generation", "representative", "development"] } }, "additionalProperties": true },
    "license": { "type": "object", "required": ["spdx", "creator", "sourceUrl", "licenseUrl", "attribution"], "properties": { "spdx": { "type": "string", "minLength": 1 }, "creator": { "type": "string", "minLength": 1 }, "sourceUrl": { "type": "string", "format": "uri" }, "licenseUrl": { "type": "string", "format": "uri" }, "attribution": { "type": "string", "minLength": 1 } } },
    "layers": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "available"], "properties": { "id": { "type": "string", "minLength": 1 }, "available": { "type": "boolean" }, "glb": { "type": "string" }, "triangles": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "allOf": [{ "if": { "properties": { "available": { "const": true } } }, "then": { "required": ["glb", "triangles", "sha256"] } }] } },
    "components": { "type": "array", "items": { "type": "object", "required": ["id", "label", "availability"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" }, "label": { "type": "string", "minLength": 1 }, "category": { "type": "string" }, "description": { "type": "string" }, "availability": { "enum": ["available", "geometry-only", "unavailable"] } } } },
    "meshMappings": { "type": "object", "additionalProperties": { "type": "string" } },
    "unmappedMeshes": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "ingestion": { "type": "object" }
  },
  "additionalProperties": true
}
