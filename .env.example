# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Configuration
PORT=4444

# Google Gemini Online API Key
GEMINI_API_KEY=your-gemini-api-key

# --- OAuth providers (Google / GitHub sign-in) ---
# Google and GitHub sign-in buttons redirect to:
#   {VITE_SUPABASE_URL}/auth/v1/authorize?provider=google|github
# For those buttons to work, each provider must be enabled in the
# Supabase dashboard (Authentication -> Providers), with its OAuth
# Client ID/Secret registered there, and the redirect URL
# ({your app origin}/) added as an allowed redirect in both the
# provider's OAuth app settings and Supabase's Auth settings.
# No client-side environment variables are needed for this; the
# provider Client ID/Secret live only in the Supabase project config.

# Device specification API — server only (never prefix with VITE_)
ICECAT_USERNAME=
ICECAT_API_TOKEN=

# Mail OAuth — server only. Register both callback URLs with each provider.
# Local callback: http://localhost:3000/api/mail/oauth/callback
# Production callback: https://your-toolbox-domain/api/mail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. If omitted, Toolbox derives this callback from the request origin.
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Long random secret used to sign short-lived OAuth state. Provider secret is used as fallback.
MAIL_OAUTH_STATE_SECRET=

# Contributions and supporter perks — server only, never VITE_ prefix.
# Run supabase/supporters.sql and use matching keys from the same Flutterwave account.
SUPABASE_SERVICE_ROLE_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
