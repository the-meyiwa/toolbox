# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Run supabase/assistant-quotas.sql before deploying the Assistant API. Its durable
# quota store uses the same Supabase project and verified user sessions.
# On the API host you may alternatively use SUPABASE_URL / SUPABASE_ANON_KEY.

# Server Configuration
PORT=4444

# Google Gemini Online API Key
GEMINI_API_KEY=your-gemini-api-key

# Fallback model providers — server only (never prefix with VITE_). Optional.
# The Assistant and the Code Playground agent switch to whichever of these is
# set when Gemini runs out of quota, is rate limited or stops responding.
# OpenRouter reaches many coding models with one key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional model override: any model id listed at https://openrouter.ai/models
# (the default, openrouter/auto, lets OpenRouter pick a capable model per request).
ASSISTANT_OPENROUTER_MODEL=

# --- OAuth providers (Google / GitHub sign-in) ---
# Google and GitHub sign-in buttons redirect to:
#   {VITE_SUPABASE_URL}/auth/v1/authorize?provider=google|github
# For those buttons to work, each provider must be enabled in the
# Supabase dashboard (Authentication -> Providers), with its OAuth
# Client ID/Secret registered there, and the redirect URL
# ({your app origin}/) added as an allowed redirect in both the
# provider's OAuth app settings and Supabase's Auth settings.
# No client-side environment variables are needed for this; the
# provider Client ID/Secret live only in the Supabase project config.

# Device specification API — server only (never prefix with VITE_)
ICECAT_USERNAME=
ICECAT_API_TOKEN=

# Mail OAuth — server only. Register both callback URLs with each provider.
# Local callback: http://localhost:3000/api/mail/oauth/callback
# Production callback: https://your-toolbox-domain/api/mail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. If omitted, Toolbox derives this callback from the request origin.
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Long random secret used to sign short-lived OAuth state. Provider secret is used as fallback.
MAIL_OAUTH_STATE_SECRET=

# Contributions and supporter perks — server only, never VITE_ prefix.
# Run supabase/supporters.sql and use matching keys from your Flutterwave account.
# Supports Flutterwave v4 Live API keys (or v4 OAuth credentials).
SUPABASE_SERVICE_ROLE_KEY=
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Or v4 OAuth credentials:
# FLW_CLIENT_ID=
# FLW_CLIENT_SECRET=
# FLW_ENCRYPTION_KEY=
# FLW_ENVIRONMENT=production

# Maps — optional extra place providers, server only (never VITE_ prefix).
# Maps works on OpenStreetMap alone; each key adds that provider's places to
# nearby search. Setup: docs/maps-providers.md
TOMTOM_API_KEY=
FOURSQUARE_API_KEY=
HERE_API_KEY=
MAPBOX_ACCESS_TOKEN=
GOOGLE_PLACES_API_KEY=

# Security: Comma-separated list of allowed frontend origins (for decoupled architectures)
# TOOLBOX_ALLOWED_ORIGINS=https://toolbox.meyigbenee.workers.dev

